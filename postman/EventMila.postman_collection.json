{
  "info": {
    "name": "EventMila API",
    "description": "Colección de pruebas para la API REST de EventMila (registro, login, perfil y CRUD de eventos). Ejecutar primero 'Login' o 'Registro' para guardar el token automáticamente en la variable de colección {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "eventoId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registro de usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro exitoso (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de Prueba\",\n  \"email\": \"prueba@unemi.edu.ec\",\n  \"username\": \"usuarioprueba\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registro"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prueba@unemi.edu.ec\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Obtener perfil (protegido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Acceso autorizado (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfil"]
            }
          }
        },
        {
          "name": "Login con Google (solo navegador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google"]
            },
            "description": "Este endpoint redirige al flujo OAuth de Google. Debe abrirse en un navegador, no puede completarse desde Postman."
          }
        }
      ]
    },
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar eventos públicos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/publicos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "publicos"]
            }
          }
        },
        {
          "name": "Crear evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Evento creado (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data._id) {",
                  "  pm.collectionVariables.set('eventoId', data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Feria Tecnológica\",\n  \"description\": \"Exposición de proyectos de estudiantes\",\n  \"date\": \"2026-09-15T18:00:00.000Z\",\n  \"location\": \"Auditorio UNEMI\",\n  \"category\": \"TECNOLOGIA\",\n  \"status\": \"public\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/eventos/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", ""]
            }
          }
        },
        {
          "name": "Listar mis eventos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/mis-eventos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "mis-eventos"]
            }
          }
        },
        {
          "name": "Obtener evento por ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "{{eventoId}}"]
            }
          }
        },
        {
          "name": "Actualizar evento",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Feria Tecnológica 2026\",\n  \"status\": \"private\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "{{eventoId}}"]
            }
          }
        },
        {
          "name": "Eliminar evento",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "{{eventoId}}"]
            }
          }
        }
      ]
    }
  ]
}
